{
  "type": "narodnyi",
  "version": "1.0.0",
  "sheet": {"strategy": "first_matching", "name_aliases": ["TDSheet", "Order"]},
  "header": {"strategy": "aliases", "search_rows": 20, "required": ["barcode", "item_name", "quantity"]},
  "columns": {
    "item_code": ["Код", "Код товара"],
    "item_name": ["Продукция", "Товар", "Наименование"],
    "barcode": ["Штрихкод", "Штрих-код"],
    "quantity": ["Заказ"]
  },
  "metadata": {"client_cell_candidates": ["B5"], "date_patterns": ["дата:"]},
  "filters": {"skip_zero_quantity": true}
}
