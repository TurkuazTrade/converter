<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="CONVERTER_API_PROXY" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8501/api/{R:1}" />
        </rule>

        <rule name="IDENTITY_API_PROXY" stopProcessing="true">
          <match url="^identity-api/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8500/api/v1/{R:1}" />
        </rule>

        <rule name="CONVERTER_HEALTH_PROXY" stopProcessing="true">
          <match url="^health$" />
          <action type="Rewrite" url="http://127.0.0.1:8501/api/v1/health" />
        </rule>

        <rule name="CONVERTER_READY_PROXY" stopProcessing="true">
          <match url="^ready$" />
          <action type="Rewrite" url="http://127.0.0.1:8501/api/v1/ready" />
        </rule>

        <rule name="CONVERTER_DOCS_PROXY" stopProcessing="true">
          <match url="^docs$" />
          <action type="Rewrite" url="http://127.0.0.1:8501/docs" />
        </rule>

        <rule name="CONVERTER_REDOC_PROXY" stopProcessing="true">
          <match url="^redoc$" />
          <action type="Rewrite" url="http://127.0.0.1:8501/redoc" />
        </rule>

        <rule name="CONVERTER_OPENAPI_PROXY" stopProcessing="true">
          <match url="^openapi.json$" />
          <action type="Rewrite" url="http://127.0.0.1:8501/openapi.json" />
        </rule>

        <rule name="REACT_ROUTES" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
